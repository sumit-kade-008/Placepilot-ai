# ==============================================================================
# PlacePilot AI — Scheme Saathi (AgentX PS-01)
# Environment Configuration
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Gemini API Integration (Server-Side Only)
# Get your API key from Google AI Studio (Settings > Secrets)
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase PostgreSQL Database & Authentication (for Google OAuth & cloud sync)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Client Environment (Vite)
VITE_APP_NAME="PlacePilot AI"
VITE_ENABLE_DEMO_MODE=true
